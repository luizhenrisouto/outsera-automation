{
  "name": "outsera-automation-test",
  "version": "1.0.0",
  "description": "Avaliação Outsera: automação de testes de API, E2E, CI/CD, carga e mobile",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report reports/html",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "resumo": "node scripts/gerar-resumo.mjs",
    "evidencias:api": "node scripts/salvar-evidencias.mjs api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
